# Copy to api.env (ignored by git), fill in, then: chmod 600 api.env
# Names match backend/.env.example. Never commit or paste real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://<API_HOST>/auth/github/callback
ALLOWED_REDIRECTS=["reporadar://auth/callback"]
TOKEN_ENCRYPTION_KEY=
HYBRID_CURSOR_SIGNING_KEY=
API_GITHUB_TOKEN=
DEEPGRAM_API_KEY=
MILVUS_URI=https://<your-cluster>.cloud.zilliz.com
MILVUS_TOKEN=
MILVUS_COLLECTION=repo_chunks_e5small_v1
# Optional off-machine copy of the auth DB and catalogue source (HD1).
# Empty keeps the sync off; the VM disk already persists.
STATE_SYNC_REPO=
STATE_SYNC_TOKEN=
# Optional summaries: workers_ai plus WORKERS_AI_ACCOUNT_ID/WORKERS_AI_API_TOKEN.
LLM_ACTIVE_PROFILE=
