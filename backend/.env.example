GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=./data/auth.sqlite3
ALLOWED_REDIRECTS=["reporadar://auth/callback"]
CORS_ORIGINS=[]
SEARCH_PAGE_SIZE=20
MAX_GITHUB_SEARCH_RESPONSE=1048576
# Archive catalogue is opt-in, WSL/Linux only; use a Linux-native private path.
ARCHIVE_DATABASE_PATH=./data/archive/catalogue.sqlite3
ARCHIVE_CONTENT_PATH=./data/archive/content
ARCHIVE_BUSY_TIMEOUT_MS=5000
# T04 worker-only archive reads. Use a dedicated public-read token, never an
# end-user OAuth token or GITHUB_CLIENT_SECRET.
ARCHIVE_GITHUB_TOKEN=
ARCHIVE_GITHUB_API_URL=https://api.github.com
ARCHIVE_GITHUB_TIMEOUT=10
ARCHIVE_GITHUB_ATTEMPTS=3
ARCHIVE_GITHUB_MAX_REDIRECTS=3
ARCHIVE_GITHUB_METADATA_BYTES=524288
ARCHIVE_GITHUB_README_BYTES=262144
ARCHIVE_GITHUB_RETRY_MAX_WAIT=5
# T09 ingestion policy. There is no built-in licence list: an empty allowlist
# refuses every repository. Add only SPDX ids the owner has approved.
ARCHIVE_LICENSE_ALLOWLIST=[]
# Minimum free bytes on the archive content filesystem before ingestion.
ARCHIVE_MIN_FREE_BYTES=2147483648
# T07 local Milvus adapter; configure only in the worker/serving process.
# No connection or collection is created by ordinary API startup.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_PROFILE=gpu
MILVUS_COLLECTION=repo_chunks_e5small_v1
MILVUS_TIMEOUT=10
MILVUS_BUILD_TIMEOUT=120
MILVUS_BATCH_SIZE=64
# T13 internal hybrid orchestration; no route is exposed yet.
HYBRID_SEARCH_BUDGET=8
HYBRID_SEARCH_MAX_WORKERS=8
HYBRID_SEARCH_MAX_OUTSTANDING=16
HYBRID_SEARCH_MAX_CONCURRENT=4
HYBRID_SEARCH_ADMISSION_TIMEOUT=0.25
HYBRID_ARCHIVE_INITIAL_LIMIT=200
HYBRID_ARCHIVE_MAX_LIMIT=1000
HYBRID_ARCHIVE_TARGET_REPOSITORIES=100
